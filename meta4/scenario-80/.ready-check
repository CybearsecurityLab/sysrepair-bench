# Harness readiness gate (task.py scenario_ready_gate): exits 0 once boot has
# finished and the protected service answers; the agent starts only after that.
# Seeding ends with the vulnerable inline policy; wait for it and the managed attachment.
awslocal iam get-user-policy --user-name app-user --policy-name AllowPolicyVersionSwitch >/dev/null 2>&1 && awslocal iam list-attached-user-policies --user-name app-user --query "AttachedPolicies[].PolicyArn" --output text 2>/dev/null | grep -q AppManagedPolicy
